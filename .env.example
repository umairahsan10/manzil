# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# ---------------------------------------------------------------------------
# LLM Provider — DeepSeek V4 Pro via opencode.ai (OpenAI-compatible)
# ---------------------------------------------------------------------------

# Get your key from https://opencode.ai/settings/api
# Comma-separated for rotation
LLM_API_KEYS=

# Optional: override the endpoint or model
# LLM_API_BASE_URL=https://opencode.ai/zen/go/v1
# LLM_MODEL=deepseek-v4-pro

# Legacy fallbacks (still work for smooth migration from Gemini)
# GEMINI_API_KEYS=
# GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Agent mode
# ---------------------------------------------------------------------------

# "true"  = Full LLM — each agent generates unique prose (16 calls/debate)
# "false" = Efficient — templated arguments, only orchestrator calls LLM (1 call/debate)
MANZIL_FULL_AGENT_LLM=false

# ---------------------------------------------------------------------------
# Rate limits (per key)
# ---------------------------------------------------------------------------

# Rate limits per key (opencode.ai supports 100 RPM by default)
MANZIL_LLM_RPM=100
MANZIL_LLM_RPD=1000

# Legacy names still work:
# MANZIL_GEMINI_RPM=10
# MANZIL_GEMINI_RPD=20

# ---------------------------------------------------------------------------
# Cache mode
# ---------------------------------------------------------------------------

# MANZIL_USE_CACHE=1  -> read from cache, fall through to API on miss (default)
# MANZIL_DEMO_MODE=1  -> read from cache only, refuse API calls (use on demo day)
MANZIL_USE_CACHE=1
MANZIL_DEMO_MODE=0

# Cache directory (relative to project root)
MANZIL_CACHE_DIR=.manzil_cache
