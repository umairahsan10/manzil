# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Cache mode flags
# MANZIL_USE_CACHE=1  -> read from cache, fall through to API on miss (default in dev)
# MANZIL_DEMO_MODE=1  -> read from cache only, refuse API calls (use on demo day)
MANZIL_USE_CACHE=1
MANZIL_DEMO_MODE=0

# Cache directory (relative to project root)
MANZIL_CACHE_DIR=.manzil_cache
