# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Get keys from https://aistudio.google.com/app/apikey
# Comma-separated for rotation (handles free-tier rate limits)
GEMINI_API_KEYS=

# DEPRECATED: single key (still works, but GEMINI_API_KEYS takes priority)
# GEMINI_API_KEY=

# Agent argument mode
# "true"  = Full LLM — each agent generates unique prose (16 calls/debate)
# "false" = Efficient — templated arguments, only orchestrator calls LLM (1 call/debate)
MANZIL_FULL_AGENT_LLM=false

# Per-key rate limits (Gemini free tier defaults)
MANZIL_GEMINI_RPM=10
MANZIL_GEMINI_RPD=20

# Cache mode flags
# MANZIL_USE_CACHE=1  -> read from cache, fall through to API on miss (default in dev)
# MANZIL_DEMO_MODE=1  -> read from cache only, refuse API calls (use on demo day)
MANZIL_USE_CACHE=1
MANZIL_DEMO_MODE=0

# Cache directory (relative to project root)
MANZIL_CACHE_DIR=.manzil_cache
